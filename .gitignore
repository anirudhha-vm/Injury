# --- Privacy (rule 7): raw video of minors never enters the repo ---
data/raw_video_LOCAL_ONLY/*
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.webm
*.MP4
*.MOV

# --- Data: only README, schema and .gitkeep are tracked ---
data/keypoints/*
data/interim/*
data/processed/*
data/synthetic/*
!data/**/.gitkeep

# --- Identity map and secrets live outside the repo ---
.env
.env.*
!.env.example
*identity_map*
*.pem
*.key

# --- Python / tooling ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Model weights (downloaded by a human, never committed) ---
/models/
*.task
*.onnx

# --- Generated paper outputs: regenerate with `make paper-figs`, never edit or commit ---
paper/figures/*
paper/tables/*
!paper/figures/.gitkeep
!paper/tables/.gitkeep

# --- Run outputs ---
outputs/
multirun/
runs/
*.nc
.ipynb_checkpoints/
.DS_Store
data/external/*
paper/ieee/build/
paper/ieee/*.pdf
paper/ieee_twin/build/
paper/ieee_twin/*.pdf
